# Copia este fichero a ".env" y rellena tus propios valores.
# NUNCA subas tu ".env" real a git (ya esta en .gitignore).

# Token del bot de Telegram. Se consigue hablando con @BotFather en Telegram
# (comando /newbot).
TELEGRAM_BOT_TOKEN=123456789:AAAA-tu-token-de-botfather-aqui

# IDs de usuario de Telegram (no el @username) que pueden hablar con el bot,
# separados por comas. Para saber tu ID, habla con @userinfobot en Telegram.
ALLOWED_USER_IDS=111111111,222222222

# Ruta absoluta al proyecto sobre el que quieres que Claude Code trabaje.
# Windows: usa barras dobles o simples, ej. C:\Users\tu_usuario\mi_proyecto
PROJECT_PATH=C:\ruta\a\tu\proyecto

# Tiempo maximo (segundos) que se espera a que Claude Code responda antes de
# abortar la ejecucion.
CLAUDE_TIMEOUT_SECONDS=900

# Tiempo maximo (segundos) para el build de Flutter lanzado con /build.
# Si tu proyecto no es Flutter, ignora esta variable y el comando /build.
BUILD_TIMEOUT_SECONDS=900

# IP/hostname por el que tu movil (u otro dispositivo) llega a este PC para
# descargar los APKs generados por /build (Tailscale, Radmin VPN, IP de LAN...).
DOWNLOAD_HOST=localhost
DOWNLOAD_PORT=8765

# Modelo y effort por defecto para Claude Code (se pueden cambiar por chat con
# /model). "sonnet" + "medium" consume muchos menos tokens que Opus para el
# uso normal por Telegram. Effort valido: low, medium, high, xhigh, max.
DEFAULT_MODEL=sonnet
DEFAULT_EFFORT=medium
